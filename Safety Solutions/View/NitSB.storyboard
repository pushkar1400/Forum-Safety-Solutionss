                                                                <rect key="frame" x="0.0" y="0.0" width="792" height="100"/>
                                                                <subviews>
                                                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="5Fc-2o-Lkm">
                                                                        <rect key="frame" x="5" y="5" width="782" height="80.5"/>
                                                                        <string key="text">I certify that I have prepared this work and equipment in accordance with Safe Work Permitting Program and agree to perform this work within the established guidelines of this document and attached issued permits or work plans.  I acknowledge that this and any other issued permits shall be voided if any unsafe conditions arise of if the conditions of any of the issued permits are not met.  I further agree to brief any additional arriving workers on all hazards, permits and safety procedures before allowing them to work.</string>
                                                                        <fontDescription key="fontDescription" name="Helvetica" family="Helvetica" pointSize="14"/>
                                                                        <nil key="textColor"/>
                                                                        <nil key="highlightedColor"/>
                                                                    </label>
