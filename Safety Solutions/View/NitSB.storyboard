                                                                <subviews>
                                                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="High Risk" textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="dqA-b4-J51">
                                                                        <rect key="frame" x="10" y="20" width="288" height="18"/>
                                                                        <fontDescription key="fontDescription" name="Charter-Bold" family="Charter" pointSize="14.600000381469727"/>
                                                                        <nil key="textColor"/>
                                                                        <nil key="highlightedColor"/>
                                                                    </label>
                                                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" usesAttributedText="YES" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="WfC-LK-XPT">
                                                                        <rect key="frame" x="10" y="43" width="288" height="75"/>
                                                                        <attributedString key="attributedText">
                                                                            <fragment content="Definition:">
                                                                                <attributes>
                                                                                    <font key="NSFont" size="14.600000381469727" name="Charter-Bold"/>
                                                                                </attributes>
                                                                            </fragment>
                                                                            <fragment content=" ">
                                                                                <attributes>
                                                                                    <font key="NSFont" size="17.600000381469727" name="Charter-Bold"/>
                                                                                </attributes>
                                                                            </fragment>
                                                                            <fragment>
                                                                                <string key="content">Hazards that pose a severe threat to life, health, or property if not adequately controlled. Immediate corrective actions are necessary. </string>
                                                                                <attributes>
                                                                                    <font key="NSFont" size="14.600000381469727" name="Charter-Roman"/>
                                                                                </attributes>
                                                                            </fragment>
                                                                        </attributedString>
                                                                        <nil key="highlightedColor"/>
                                                                    </label>
                                                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Details" textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="Pjp-XO-rY2">
                                                                        <rect key="frame" x="10" y="138" width="288" height="18"/>
                                                                        <fontDescription key="fontDescription" name="Charter-Bold" family="Charter" pointSize="14.600000381469727"/>
                                                                        <nil key="textColor"/>
                                                                        <nil key="highlightedColor"/>
                                                                    </label>
                                                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" usesAttributedText="YES" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="KFM-o8-glC">
                                                                        <rect key="frame" x="10" y="161" width="288" height="51.5"/>
                                                                        <attributedString key="attributedText">
                                                                            <fragment content="Severity:">
                                                                                <attributes>
                                                                                    <font key="NSFont" size="14" name="Charter-Bold"/>
                                                                                    <font key="NSOriginalFont" size="14" name="Charter-Bold"/>
                                                                                    <paragraphStyle key="NSParagraphStyle" alignment="left" lineBreakMode="wordWrapping" baseWritingDirection="natural" tighteningFactorForTruncation="0.0" allowsDefaultTighteningForTruncation="NO"/>
                                                                                </attributes>
                                                                            </fragment>
                                                                            <fragment content=" Catastrophic or critical consequences, such as fatalities, life-altering injuries, or significant property damage.">
                                                                                <attributes>
                                                                                    <font key="NSFont" size="14" name="Charter-Roman"/>
                                                                                    <paragraphStyle key="NSParagraphStyle" alignment="left" lineBreakMode="wordWrapping" baseWritingDirection="natural" tighteningFactorForTruncation="0.0" allowsDefaultTighteningForTruncation="NO"/>
                                                                                </attributes>
                                                                            </fragment>
                                                                        </attributedString>
                                                                        <nil key="highlightedColor"/>
                                                                    </label>
                                                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" usesAttributedText="YES" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="riu-pC-vsP">
                                                                        <rect key="frame" x="10" y="217.5" width="288" height="53.5"/>
                                                                        <attributedString key="attributedText">
                                                                            <fragment content="Frequency: ">
                                                                                <attributes>
                                                                                    <font key="NSFont" size="14.600000381469727" name="Charter-Bold"/>
                                                                                </attributes>
                                                                            </fragment>
                                                                            <fragment content="Occurs frequently (daily/weekly) or is highly likely to occur during a task.">
                                                                                <attributes>
                                                                                    <font key="NSFont" size="14.600000381469727" name="Charter-Roman"/>
                                                                                </attributes>
                                                                            </fragment>
                                                                        </attributedString>
                                                                        <nil key="highlightedColor"/>
                                                                    </label>
                                                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" usesAttributedText="YES" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="cPu-7v-Gpu">
                                                                        <rect key="frame" x="10" y="276" width="288" height="51.5"/>
                                                                        <attributedString key="attributedText">
                                                                            <fragment content="Probability:">
                                                                                <attributes>
                                                                                    <font key="NSFont" size="14" name="Charter-Bold"/>
                                                                                    <paragraphStyle key="NSParagraphStyle" alignment="left" lineBreakMode="wordWrapping" baseWritingDirection="natural" tighteningFactorForTruncation="0.0" allowsDefaultTighteningForTruncation="NO"/>
                                                                                </attributes>
                                                                            </fragment>
                                                                            <fragment content=" Very high likelihood of occurrence under existing conditions (e.g., exposure is constant, or conditions are uncontrollable).">
                                                                                <attributes>
                                                                                    <font key="NSFont" size="14" name="Charter-Roman"/>
                                                                                    <paragraphStyle key="NSParagraphStyle" alignment="left" lineBreakMode="wordWrapping" baseWritingDirection="natural" tighteningFactorForTruncation="0.0" allowsDefaultTighteningForTruncation="NO"/>
                                                                                </attributes>
                                                                            </fragment>
                                                                        </attributedString>
                                                                        <nil key="highlightedColor"/>
                                                                    </label>
