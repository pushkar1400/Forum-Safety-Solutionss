                                                                                                                <attributedString key="attributedText">
                                                                                                                    <fragment>
                                                                                                                        <string key="content">If the only hazard posed by the permit space is an actual or potential hazardous atmosphere and all other hazards have been eliminated by checking the corresponding methods below, the space can be classified as an </string>
                                                                                                                        <attributes>
                                                                                                                            <font key="NSFont" metaFont="system" size="17"/>
                                                                                                                        </attributes>
                                                                                                                    </fragment>
                                                                                                                    <fragment content="Alternate Procedures">
                                                                                                                        <attributes>
                                                                                                                            <color key="NSBackgroundColor" red="1" green="0.94645596385403519" blue="0.0" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                                                                                                            <font key="NSFont" metaFont="system" size="17"/>
                                                                                                                        </attributes>
                                                                                                                    </fragment>
                                                                                                                    <fragment>
                                                                                                                        <string key="content"> space. Supervisor must complete this Assessment, sign and date the form below, entering the space with continuous air monitoring and ventilation.</string>
                                                                                                                        <attributes>
                                                                                                                            <font key="NSFont" metaFont="system" size="17"/>
                                                                                                                        </attributes>
                                                                                                                    </fragment>
                                                                                                                </attributedString>
                                                                                                                <nil key="highlightedColor"/>
                                                                                                                <string key="userLabel">If the only hazard posed by the permit space is a potential hazardous atmosphere and all other hazards have been eliminated by checking the corresponding methods below, the space can be classified as an Alternate Methods space.  A Supervisor must complete this Assessment, sign and date the form below, entering the space with continuous air monitoring and ventilation.</string>
