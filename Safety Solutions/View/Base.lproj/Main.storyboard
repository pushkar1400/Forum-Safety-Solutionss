                                                                        <rect key="frame" x="33" y="0.0" width="909" height="80"/>
                                                                        <attributedString key="attributedText">
                                                                            <fragment>
                                                                                <string key="content">If the only hazard posed by the permit space is an actual or potential hazardous atmosphere and all other hazaras have been eliminated by checking the corresponding methods below, the space can be classified as an </string>
                                                                                <attributes>
                                                                                    <font key="NSFont" size="17" name="Helvetica"/>
                                                                                    <paragraphStyle key="NSParagraphStyle" alignment="left" lineBreakMode="wordWrapping" baseWritingDirection="natural" tighteningFactorForTruncation="0.0" allowsDefaultTighteningForTruncation="NO">
                                                                                        <tabStops>
                                                                                            <textTab alignment="left" location="28">
                                                                                                <options/>
                                                                                            </textTab>
                                                                                            <textTab alignment="natural" location="56">
                                                                                                <options/>
                                                                                            </textTab>
                                                                                            <textTab alignment="left" location="84">
                                                                                                <options/>
                                                                                            </textTab>
                                                                                            <textTab alignment="left" location="112">
                                                                                                <options/>
