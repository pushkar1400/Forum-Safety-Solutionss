                                                                        <rect key="frame" x="33" y="0.0" width="909" height="60"/>
                                                                        <attributedString key="attributedText">
                                                                            <fragment>
                                                                                <string key="content">If all hazards cannot be eliminated by checking the corresponding method below or hazards in the ﻿﻿grey box are checked, the space is a </string>
                                                                                <attributes>
                                                                                    <font key="NSFont" size="17" name="Helvetica"/>
                                                                                    <paragraphStyle key="NSParagraphStyle" alignment="left" lineBreakMode="wordWrapping" baseWritingDirection="natural" tighteningFactorForTruncation="0.0" allowsDefaultTighteningForTruncation="NO"/>
                                                                                </attributes>
                                                                            </fragment>
                                                                            <fragment content="Permit Required Confined Space">
                                                                                <attributes>
                                                                                    <color key="NSBackgroundColor" red="0.57045853140000002" green="0.57047235969999999" blue="0.57046490910000003" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                                                                    <font key="NSFont" size="17" name="Helvetica"/>
