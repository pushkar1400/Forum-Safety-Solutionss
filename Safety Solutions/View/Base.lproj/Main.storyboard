                                                                <rect key="frame" x="10" y="10" width="962" height="39.5"/>
                                                                <string key="text">A Competent Person must evaluate the space using the Hazard Analysis (Boxes 1-22) below, this includes documented initial air monitoring.</string>
                                                                <fontDescription key="fontDescription" name="Helvetica" family="Helvetica" pointSize="17"/>
