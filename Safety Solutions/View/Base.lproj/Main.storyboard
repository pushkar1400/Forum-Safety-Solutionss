                                                                <rect key="frame" x="0.0" y="0.0" width="982" height="73"/>
                                                                <attributedString key="attributedText">
                                                                    <fragment content="STCKY – Stuff that can Kill You">
                                                                        <attributes>
                                                                            <font key="NSFont" size="15" name="Helvetica-Bold"/>
                                                                            <paragraphStyle key="NSParagraphStyle" alignment="center" lineBreakMode="wordWrapping" baseWritingDirection="natural" tighteningFactorForTruncation="0.0"/>
                                                                        </attributes>
                                                                    </fragment>
                                                                    <fragment>
                                                                        <string key="content">
Electrical shock and arc flash can kill you.
LOTO all equipment and live electrical before starting work.</string>
                                                                        <attributes>
                                                                            <font key="NSFont" size="15" name="Helvetica"/>
                                                                            <paragraphStyle key="NSParagraphStyle" alignment="center" lineBreakMode="wordWrapping" baseWritingDirection="natural" tighteningFactorForTruncation="0.0"/>
