                                                    <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="lu2-T0-FdK">
                                                        <rect key="frame" x="1" y="466" width="982" height="80"/>
                                                        <subviews>
                                                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" textAlignment="center" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="Gh7-h5-4s6">
                                                                <rect key="frame" x="0.0" y="0.0" width="982" height="80"/>
                                                                <string key="text">Authorized employees must be trained on Hazardous Chemicals per WAC 296-901 and be briefed on this  Hazardous Chemical and Respirator Plan. As Authorized Employees, you are signing that you have reviewed this plan.  A Competent Person must complete this plan and make sure all employees are following safe work practices.</string>
                                                                <fontDescription key="fontDescription" name="Helvetica" family="Helvetica" pointSize="17"/>
                                                                <nil key="textColor"/>
                                                                <nil key="highlightedColor"/>
                                                            </label>
                                                        </subviews>
