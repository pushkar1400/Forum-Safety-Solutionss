                                                                <attributedString key="attributedText">
                                                                    <fragment>
                                                                        <string key="content">I have received Confined Space Awareness training, and I understand all the learning objectives above.   I understand this training</string>
                                                                        <attributes>
                                                                            <color key="NSColor" red="0.0" green="0.0" blue="0.0" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                                                            <font key="NSFont" size="14" name="ArialMT"/>
