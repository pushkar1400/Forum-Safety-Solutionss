                                                    <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="ulL-O1-393">
                                                        <rect key="frame" x="1" y="486" width="982" height="80"/>
                                                        <subviews>
                                                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" textAlignment="center" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="Que-a3-q1S">
                                                                <rect key="frame" x="0.0" y="0.0" width="982" height="80"/>
                                                                <string key="text">Authorized employees must be trained on Welding and Hot Work Hazards and briefed on this  Hot Work Permit. As Authorized Employees, you are signing that you have reviewed this plan.
A Competent Person must complete this plan and make sure all employees are following safe work practices.</string>
                                                                <fontDescription key="fontDescription" name="Helvetica" family="Helvetica" pointSize="17"/>
                                                                <nil key="textColor"/>
                                                                <nil key="highlightedColor"/>
                                                            </label>
                                                        </subviews>
                                                        <color key="backgroundColor" systemColor="systemBackgroundColor"/>
                                                        <constraints>
                                                            <constraint firstItem="Que-a3-q1S" firstAttribute="top" secondItem="ulL-O1-393" secondAttribute="top" id="73i-u9-Mut"/>
                                                            <constraint firstItem="Que-a3-q1S" firstAttribute="leading" secondItem="ulL-O1-393" secondAttribute="leading" id="Zg5-UI-ikQ"/>
                                                            <constraint firstAttribute="bottom" secondItem="Que-a3-q1S" secondAttribute="bottom" id="enf-zF-gVz"/>
                                                            <constraint firstAttribute="trailing" secondItem="Que-a3-q1S" secondAttribute="trailing" id="jwX-lz-H2v"/>
                                                            <constraint firstAttribute="height" constant="80" id="wuu-Nw-keA"/>
                                                        </constraints>
                                                    </view>
                                                    <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="HXN-LH-7Dt">
                                                        <rect key="frame" x="1" y="567" width="982" height="92"/>
                                                        <subviews>
                                                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" usesAttributedText="YES" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="IZH-o0-Lba">
                                                                <rect key="frame" x="0.0" y="0.0" width="982" height="92"/>
                                                                <attributedString key="attributedText">
                                                                    <fragment content="STCKY – STUFF THAT CAN KILL YOU">
                                                                        <attributes>
                                                                            <color key="NSColor" red="0.0" green="0.0" blue="0.0" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                                                            <font key="NSFont" size="17" name="Helvetica-Bold"/>
                                                                            <paragraphStyle key="NSParagraphStyle" alignment="center" lineBreakMode="wordWrapping" baseWritingDirection="leftToRight" defaultTabInterval="36" tighteningFactorForTruncation="0.0" allowsDefaultTighteningForTruncation="NO">
                                                                                <tabStops/>
                                                                            </paragraphStyle>
                                                                        </attributes>
                                                                    </fragment>
                                                                    <fragment>
                                                                        <string key="content">
Hot work fires can result in avoidable death, injury, and property loss.   Have Fire Extinguishers and use a Fire Watch anywhere you are making sparks.</string>
                                                                        <attributes>
                                                                            <color key="NSColor" red="0.0" green="0.0" blue="0.0" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                                                            <font key="NSFont" size="17" name="Helvetica"/>
                                                                            <paragraphStyle key="NSParagraphStyle" alignment="center" lineBreakMode="wordWrapping" baseWritingDirection="leftToRight" defaultTabInterval="36" tighteningFactorForTruncation="0.0" allowsDefaultTighteningForTruncation="NO">
